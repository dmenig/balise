# TLS, HSTS, CSP without unsafe-inline, and a hard rate limit in front of the app (docs/12).
{
	email ops@balise.fr
}

api.balise.fr {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self)"
		-Server
	}

	# Tiles are immutable per `ref_version` and absorbed by the CDN.
	@tiles path /v1/tiles/*
	header @tiles Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	# Status must never be cached by an intermediary.
	@status path /v1/status*
	header @status Cache-Control "no-store"

	reverse_proxy api:8000 {
		lb_policy least_conn
		health_uri /health
		health_interval 10s
	}
}

balise.fr, www.balise.fr {
	encode zstd gzip
	root * /srv/web

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org https://tiles.openseamap.org; connect-src 'self' https://api.balise.fr wss://api.balise.fr; worker-src 'self' blob:; style-src 'self'; script-src 'self'; font-src 'self' https://demotiles.maplibre.org; frame-ancestors 'none'; base-uri 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Hashed assets are immutable; the shell and the service worker never are.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@shell path /index.html /sw.js /manifest.webmanifest
	header @shell Cache-Control "no-cache"

	try_files {path} {path}/index.html /index.html
	file_server
}
