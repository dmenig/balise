# --- database
# DB_PORT / REDIS_PORT are the *host* ports docker compose publishes. Change them (and the URLs
# below) if something already listens on 5432/6379 on your machine.
DB_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://balise:balise@localhost:5432/balise
REDIS_URL=redis://localhost:6379/0

# --- api
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
SECRET_KEY=change-me-32-bytes-minimum-secret-key
DEVICE_TOKEN_SALT=change-me
ENV=local                       # local|staging|prod
LOG_LEVEL=INFO

# --- external sources
SHOM_WFS_URL=https://services.data.shom.fr/INSPIRE/wfs
SHOM_TIDE_API_URL=https://services.data.shom.fr/hdm/spm/ports
SHOM_TIDE_API_KEY=              # optional; tides disabled if empty
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_USER_AGENT=balise.fr (contact@balise.fr)
GEOFABRIK_URL=https://download.geofabrik.de/europe/france-latest.osm.pbf
OPEN_METEO_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
AISSTREAM_URL=wss://stream.aisstream.io/v0/stream
AISSTREAM_API_KEY=              # 🔌 v2 only; AIS tier disabled if empty

# --- feature flags
# v1 ships with availability off. Turning it on requires the v2 code (docs/06 §A); the flag exists
# so the seam has exactly one switch, in exactly one place — `grep -rn FEATURE_AVAILABILITY api/src`
# must return 1, and a CI seam test enforces it.
FEATURE_AVAILABILITY=false      # false → NullAvailabilityProvider, /status & /reports → 501
FEATURE_AIS=false               # 🔌 v2
FEATURE_WEBSOCKET=false         # 🔌 v2

# --- storage (photos)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=balise-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

# --- ingest
RAW_DIR=raw
